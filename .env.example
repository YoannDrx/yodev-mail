# This is the only environment template tracked by Git.
# Run `npm run env:normalize` to create or reorganize the ignored `.env.local`.
# Never create or commit `.env`, `.env.production`, or files containing secrets.

# Public application configuration (browser-visible)
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_MARKETING_URL=https://yodev.fr/fr/mail

# Better Auth (use distinct secrets and OAuth clients per environment)
BETTER_AUTH_SECRET=
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3000
BETTER_AUTH_GOOGLE_CLIENT_ID=
BETTER_AUTH_GOOGLE_CLIENT_SECRET=
BETTER_AUTH_EMAIL_PASSWORD_ENABLED=false
AUTH_BOOTSTRAP_EMAIL=yoann.andrieux@gmail.com

# Neon (the only two connection variables used by the application and Drizzle)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Application secrets (32+ random bytes)
API_KEY_PEPPER=
WEBHOOK_SIGNING_SECRET=

# AWS application runtime via Vercel OIDC (optional for local development)
AWS_REGION=eu-west-3
AWS_ACCOUNT_ID=
AWS_OIDC_AUDIENCE=
AWS_ROLE_ARN=
AWS_EMAIL_QUEUE_URL=
AWS_PROVIDER_EVENTS_QUEUE_URL=
AWS_PROVIDER_PROVISIONING_QUEUE_URL=
AWS_ATTACHMENTS_BUCKET=

# Transactional providers (fail closed locally)
SES_ENABLED=false
POSTMARK_ENABLED=false
POSTMARK_WEBHOOK_BASE_URL=
POSTMARK_SYSTEM_SERVER_TOKEN_PARAMETER=/yodev-mail-dev/providers/postmark/system/server-token

# Stripe beta catalog
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLATFORM=
STRIPE_PRICE_USAGE=
STRIPE_METER_EVENT_NAME=yodev_mail_emails_sent

# Production gates — enable only after the matching certification is complete
COMMERCIAL_ONBOARDING_ENABLED=false
LIVE_CHECKOUT_ENABLED=false
STRIPE_USAGE_REPORTING_ENABLED=false
ATTACHMENTS_ENABLED=false
RAW_EMAIL_ENABLED=false
LIVE_EMAIL_ACCEPTANCE_ENABLED=false
CUSTOMER_WEBHOOKS_ENABLED=false

# Local CDK deployment inputs (not Vercel runtime variables)
# Keep ACTIVE_ENVIRONMENTS aligned with every active deployed stack; leave it
# empty only for a brand-new passive environment.
AWS_PROFILE=
YODEV_MAIL_ALERT_EMAIL=
YODEV_MAIL_AWS_ACTIVE_ENVIRONMENTS=
YODEV_MAIL_GUARDDUTY_ENABLED=false
YODEV_MAIL_POSTMARK_ENABLED=false
YODEV_MAIL_STRIPE_USAGE_REPORTING_ENABLED=false
YODEV_MAIL_VERCEL_OIDC_PROVIDER_ARN=
