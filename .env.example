# Public application configuration
NEXT_PUBLIC_APP_URL=https://mail.yodev.fr
NEXT_PUBLIC_MARKETING_URL=https://yodev.fr/fr/mail
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/connexion
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/inscription
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/onboarding

# Clerk
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Neon
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Application secrets (32+ random bytes)
API_KEY_PEPPER=
WEBHOOK_SIGNING_SECRET=
ADMIN_USER_IDS=

# AWS via Vercel OIDC
AWS_REGION=eu-west-3
AWS_ACCOUNT_ID=
AWS_OIDC_AUDIENCE=https://vercel.com/yoanndrxs-projects
AWS_ROLE_ARN=
AWS_EMAIL_QUEUE_URL=
AWS_PROVIDER_EVENTS_QUEUE_URL=
AWS_PROVIDER_PROVISIONING_QUEUE_URL=
AWS_ATTACHMENTS_BUCKET=
SES_ENABLED=false
POSTMARK_ENABLED=true

# Stripe beta catalog
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PLATFORM=
STRIPE_PRICE_USAGE=
STRIPE_METER_EVENT_NAME=yodev_mail_emails_sent

# Optional observability
SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Local CDK safety context (not Vercel runtime variables)
YODEV_MAIL_AWS_ACTIVE_ENVIRONMENTS=
YODEV_MAIL_GUARDDUTY_ENABLED=false
YODEV_MAIL_VERCEL_OIDC_PROVIDER_ARN=arn:aws:iam::AWS_ACCOUNT_ID:oidc-provider/oidc.vercel.com/yoanndrxs-projects
